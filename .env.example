# Адрес сайта (для ссылок, Open Graph, sitemap). В продакшене — https://ваш-домен
SITE_URL=http://localhost:3000

# Владелец админки (/admin). В продакшене ADMIN_PASSWORD и SESSION_SECRET обязательны, иначе вход закрыт.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-long-password
# Длинная случайная строка: openssl rand -hex 32
SESSION_SECRET=

# Номер WhatsApp по умолчанию (дальше меняется в админке → Контакты), только цифры
WHATSAPP_NUMBER=821000000000

# Откуда брать IP посетителя: 0 — прямое подключение, 1 — за nginx, cloudflare — за Cloudflare / Cloudflare Tunnel
TRUST_PROXY=0

# Двухфакторная защита админки обязательна. Отключить: REQUIRE_2FA=0
# REQUIRE_2FA=1

# Демо-данные при пустой базе: по умолчанию включены только вне продакшена. Принудительно: SEED_DEMO=true / false
# SEED_DEMO=false

# Автоперевод объявлений (console.anthropic.com → API Keys). Без ключа показывается оригинал.
ANTHROPIC_API_KEY=
# TRANSLATE_MODEL=claude-opus-5-5

# Уведомления в Telegram (бот от @BotFather; chat_id через getUpdates). Несколько получателей — через запятую.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Пути к базе и фото (по умолчанию ./data)
# DATABASE_PATH=./data/app.db
# UPLOAD_DIR=./data/uploads
