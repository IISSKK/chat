# Публичный адрес сайта (нужен для Open Graph и ссылок в WhatsApp)
SITE_URL=http://localhost:3000

# Доступ в админку (/admin). ОБЯЗАТЕЛЬНО смените в продакшене!
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Случайная длинная строка для подписи cookie сессии
SESSION_SECRET=replace-with-a-long-random-string

# Номер WhatsApp в международном формате, только цифры
WHATSAPP_NUMBER=821000000000

# Путь к базе SQLite и папке загрузок (необязательно)
# DATABASE_PATH=./data/app.db
# UPLOAD_DIR=./data/uploads

# Сайт стоит за nginx / Cloudflare, который сам выставляет X-Real-IP / X-Forwarded-For.
# Включите (1), чтобы ограничение попыток входа учитывало и IP. Без прокси оставьте 0 — иначе IP можно подделать.
TRUST_PROXY=0
