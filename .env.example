# Публичный адрес сайта (нужен для Open Graph и ссылок в WhatsApp)
SITE_URL=http://localhost:3000

# Доступ в админку (/admin). ОБЯЗАТЕЛЬНО смените в продакшене!
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Случайная длинная строка для подписи cookie сессии
SESSION_SECRET=replace-with-a-long-random-string

# Номер WhatsApp в международном формате, только цифры
WHATSAPP_NUMBER=821000000000

# Путь к базе SQLite и папке загрузок (необязательно)
# DATABASE_PATH=./data/app.db
# UPLOAD_DIR=./data/uploads

# Сайт стоит за nginx / Cloudflare, который сам выставляет X-Real-IP / X-Forwarded-For.
# Включите (1), чтобы ограничение попыток входа учитывало и IP. Без прокси оставьте 0 — иначе IP можно подделать.

# ---- Автоперевод объявлений (Claude API) ----
# Ключ с https://console.anthropic.com → API Keys. Без ключа автоперевод выключен (сайт показывает оригинал).
ANTHROPIC_API_KEY=
# Модель перевода. По умолчанию claude-opus-5-5 (лучшее качество). Дешевле: claude-haiku-5-5
# TRANSLATE_MODEL=claude-opus-5-5

# ---- Уведомления в Telegram ----
# 1) в Telegram найдите @BotFather → /newbot → получите токен; 2) напишите своему боту любое сообщение;
# 3) откройте https://api.telegram.org/bot<ТОКЕН>/getUpdates и возьмите chat.id. Несколько получателей — через запятую.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Безопасность ----
# Если сайт за Cloudflare — поставьте cloudflare (берётся IP из CF-Connecting-IP и страна из CF-IPCountry).
# Если за nginx без Cloudflare — 1. Без прокси — 0. Значение по умолчанию: 0.
TRUST_PROXY=0
# Обязать всех администраторов включить двухфакторную защиту (1 = да)
# 2FA обязательна по умолчанию (при первом входе предложит настроить). Отключить, только если очень нужно: REQUIRE_2FA=0
# REQUIRE_2FA=1
